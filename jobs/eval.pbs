#!/bin/bash
#PBS -N lsfb-batch-eval
#PBS -q umagpu
#PBS -m abe
#PBS -l walltime=167:00:00
#PBS -e outputs/batch-eval/err.log
#PBS -o outputs/batch-eval/out.log

set -e
set -u

echo "=========================================="
echo "=== PBS job started ======================"
echo "Job ID:        $PBS_JOBID"
echo "Queue:         $PBS_QUEUE"
echo "Node:          $(hostname)"
echo "Workdir:       $PBS_O_WORKDIR"
echo "Date:          $(date)"
echo "=========================================="
echo

cd "$PBS_O_WORKDIR"

mkdir -p /work/username/islr-jepa/batch-eval
mkdir -p outputs/batch-eval

echo "=== GPU visibility check ==="
nvidia-smi
echo

echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-not set}"
echo

echo "=== Starting eval ==="
echo

uv run --offline scripts/batch_evaluate.py \
	--output-root outputs/batch-eval \
	--dry-run

cp -r /work/username/islr-jepa/batch-eval/* outputs/batch-eval/

echo
echo "=========================================="
echo "=== PBS job finished ====================="
echo "Date: $(date)"
echo "=========================================="